---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "OpenTeleport",
  description = "Move your AI agent between apps in one command. Open source, Apache-2.0.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#06050b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://openteleport.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://openteleport.dev/" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Apply a saved theme before the first paint; otherwise the system setting decides.
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <canvas id="stars" aria-hidden="true"></canvas>
    <Header />
    <main id="main" class="wrap">
      <slot />
      <Footer />
    </main>

    <style>
      #stars {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        display: none;
      }
      :global(:root[data-theme="dark"]) #stars {
        display: block;
      }
      @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) #stars {
          display: block;
        }
      }
      main {
        position: relative;
        z-index: 1;
      }
    </style>

    <script>
      // A still starfield behind the dark theme. Painted once per size; nothing moves.
      const c = document.getElementById("stars") as HTMLCanvasElement;
      const g = c.getContext("2d");
      let timer = 0;
      function paint() {
        if (!g) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        const W = window.innerWidth;
        const H = window.innerHeight;
        c.width = Math.round(W * dpr);
        c.height = Math.round(H * dpr);
        g.setTransform(dpr, 0, 0, dpr, 0, 0);
        g.clearRect(0, 0, W, H);
        const n = Math.round((W * H) / 7000);
        for (let i = 0; i < n; i++) {
          g.fillStyle = `rgba(215,220,245,${0.12 + Math.random() * 0.5})`;
          g.beginPath();
          g.arc(Math.random() * W, Math.random() * H, Math.random() < 0.9 ? 0.6 : 1.1, 0, 6.2832);
          g.fill();
        }
      }
      paint();
      window.addEventListener("resize", () => {
        clearTimeout(timer);
        timer = window.setTimeout(paint, 150);
      });
    </script>
  </body>
</html>

{
  "name": "openteleport",
  "version": "0.4.2",
  "description": "Move your AI agent between apps in one command.",
  "keywords": [
    "ai",
    "agents",
    "openclaw",
    "claude-code",
    "agents-md",
    "agent-skills",
    "portability",
    "jetpack"
  ],
  "homepage": "https://openteleport.dev",
  "bugs": {
    "url": "https://github.com/Open-Teleport/openteleport/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Teleport/openteleport.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "openteleport": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/scripts",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "schema": "node dist/scripts/emit-schema.js",
    "verify:package": "node scripts/verify-package.mjs",
    "check:plugin-versions": "node scripts/sync-plugin-versions.mjs --check",
    "sync:plugin-versions": "node scripts/sync-plugin-versions.mjs --write"
  },
  "dependencies": {
    "@clack/prompts": "^0.10",
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "^13",
    "execa": "^9",
    "fflate": "^0.8",
    "json5": "^2",
    "smol-toml": "^1.9",
    "ulid": "^2",
    "yaml": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
